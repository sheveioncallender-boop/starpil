<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_partner_form_starpil_pro" model="ir.ui.view">
    <field name="name">res.partner.form.starpil.pro</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Starpil Pro">
          <group>
            <field name="starpil_pro_approved"/>
            <field name="starpil_pro_role"/>
            <field name="starpil_business_name"/>
            <field name="starpil_pro_application_id"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
