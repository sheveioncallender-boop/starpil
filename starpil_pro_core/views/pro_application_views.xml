<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_starpil_pro_application_list" model="ir.ui.view">
    <field name="name">starpil.pro.application.list</field>
    <field name="model">starpil.pro.application</field>
    <field name="arch" type="xml">
      <list decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-warning="state in ('pending', 'more_info')">
        <field name="create_date"/>
        <field name="name"/>
        <field name="business_name"/>
        <field name="professional_role"/>
        <field name="email"/>
        <field name="state" widget="badge"/>
        <field name="reviewed_by"/>
      </list>
    </field>
  </record>
  <record id="view_starpil_pro_application_search" model="ir.ui.view">
    <field name="name">starpil.pro.application.search</field>
    <field name="model">starpil.pro.application</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="email"/>
        <field name="business_name"/>
        <filter string="Awaiting Review" name="pending" domain="[('state','=','pending')]"/>
        <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
        <filter string="Rejected" name="rejected" domain="[('state','=','rejected')]"/>
        <group expand="0" string="Group By"><filter string="Status" name="group_state" context="{'group_by':'state'}"/></group>
      </search>
    </field>
  </record>
  <record id="view_starpil_pro_application_form" model="ir.ui.view">
    <field name="name">starpil.pro.application.form</field>
    <field name="model">starpil.pro.application</field>
    <field name="arch" type="xml">
      <form string="Professional Application">
        <header>
          <button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state not in ('pending','more_info')"/>
          <button name="action_request_more_info" type="object" string="Request More Information" invisible="state != 'pending'"/>
          <button name="action_reject" type="object" string="Reject" class="btn-secondary" invisible="state not in ('pending','more_info')" confirm="Reject this application?"/>
          <field name="state" widget="statusbar" statusbar_visible="unverified,pending,more_info,approved,rejected"/>
        </header>
        <sheet>
          <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
          <group>
            <group>
              <field name="email"/>
              <field name="phone"/>
              <field name="business_name"/>
              <field name="professional_role"/>
            </group>
            <group>
              <field name="email_verified_at"/>
              <field name="reviewed_at"/>
              <field name="reviewed_by"/>
              <field name="user_id"/>
              <field name="partner_id"/>
              <field name="website_id"/>
            </group>
          </group>
          <notebook>
            <page string="Credential"><field name="certificate_filename"/><field name="certificate" filename="certificate_filename"/></page>
            <page string="Applicant Notes"><field name="notes"/></page>
            <page string="Review"><field name="admin_notes" placeholder="Required context for a rejection or more-information request..."/></page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_starpil_pro_applications" model="ir.actions.act_window">
    <field name="name">Pro Applications</field>
    <field name="res_model">starpil.pro.application</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_starpil_pro_application_search"/>
    <field name="context">{'search_default_pending': 1}</field>
  </record>
  <menuitem id="menu_starpil_root" name="Starpil" sequence="35" groups="starpil_pro_core.group_starpil_pro_manager"/>
  <menuitem id="menu_starpil_pro_applications" name="Pro Applications" parent="menu_starpil_root" action="action_starpil_pro_applications" sequence="10" groups="starpil_pro_core.group_starpil_pro_manager"/>
</odoo>
