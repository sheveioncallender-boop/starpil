<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="pro_account_page" name="Starpil Pro Account">
    <t t-call="website.layout">
      <main class="container py-5">
        <div class="row g-5 justify-content-center">
          <section class="col-lg-5">
            <span class="text-uppercase small fw-bold" style="color:#a3335c">Professional access</span>
            <h1 class="display-5 mt-2">Apply for a Starpil Pro account.</h1>
            <p class="lead">Verified beauty professionals receive protected pricing, online ordering, rewards and a digital membership card.</p>
            <ol class="mt-4"><li>Create your account once.</li><li>Verify your email.</li><li>Our team reviews your credential.</li><li>After approval, sign in to see prices and order.</li></ol>
          </section>
          <section class="col-lg-6">
            <form action="/pro-account/apply" method="post" enctype="multipart/form-data" class="card border-0 shadow-sm p-4">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
              <div t-if="error" class="alert alert-danger" role="alert"><t t-out="error"/></div>
              <div class="row g-3">
                <div class="col-12"><label class="form-label">Full name</label><input class="form-control" name="name" required="required" t-att-value="form.get('name','')"/></div>
                <div class="col-md-6"><label class="form-label">Email</label><input class="form-control" type="email" name="email" required="required" t-att-value="form.get('email','')"/></div>
                <div class="col-md-6"><label class="form-label">Phone</label><input class="form-control" name="phone" required="required" t-att-value="form.get('phone','')"/></div>
                <div class="col-12"><label class="form-label">Business or school</label><input class="form-control" name="business_name" required="required" t-att-value="form.get('business_name','')"/></div>
                <div class="col-md-6"><label class="form-label">Professional role</label><select class="form-select" name="professional_role" required="required"><option value="">Select</option><option value="esthetician">Esthetician</option><option value="salon_owner">Salon / Spa Owner</option><option value="educator">Educator</option><option value="student">Student</option><option value="other">Other Professional</option></select></div>
                <div class="col-md-6"><label class="form-label">Create password</label><input class="form-control" type="password" minlength="8" name="password" required="required"/></div>
                <div class="col-12"><label class="form-label">Certificate or professional credential</label><input class="form-control" type="file" accept=".pdf,.jpg,.jpeg,.png" name="certificate" required="required"/><small class="text-muted">PDF, JPG or PNG. Maximum 8 MB.</small></div>
                <div class="col-12"><label class="form-label">Notes</label><textarea class="form-control" name="notes" rows="3"><t t-out="form.get('notes','')"/></textarea></div>
                <div class="col-12"><button class="btn w-100 fw-bold py-3" style="background:#ff9ebe;color:#24191d" type="submit">Submit professional application</button></div>
              </div>
            </form>
          </section>
        </div>
      </main>
    </t>
  </template>
  <template id="pro_account_check_email" name="Check Your Email">
    <t t-call="website.layout"><main class="container py-5 text-center"><div class="mx-auto" style="max-width:650px"><span style="font-size:3rem">✉</span><h1>Check your email.</h1><p class="lead">Use the verification link we sent. Once verified, your application moves to administrator review. Prices remain protected until approval.</p></div></main></t>
  </template>
  <template id="pro_account_verification_result" name="Verification Result">
    <t t-call="website.layout"><main class="container py-5 text-center"><div class="mx-auto" style="max-width:650px"><t t-if="verified"><h1>Email verified.</h1><p class="lead">Your application is now waiting for review. We will email you after it is approved or if more information is needed.</p></t><t t-else=""><h1>Verification link unavailable.</h1><p class="lead">The link is invalid, expired or was already used. Contact Starpil Caribbean if you need help.</p></t></div></main></t>
  </template>
</odoo>
