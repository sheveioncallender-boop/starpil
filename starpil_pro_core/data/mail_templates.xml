<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="mail_template_pro_verify_email" model="mail.template">
    <field name="name">Starpil Pro: Verify Email</field>
    <field name="model_id" ref="model_starpil_pro_application"/>
    <field name="subject">Verify your Starpil Pro account</field>
    <field name="email_to">{{ object.email }}</field>
    <field name="body_html" type="html">
      <div style="font-family:Arial,sans-serif;color:#2d2226">
        <h2>Verify your email</h2>
        <p>Hello <t t-out="object.name"/>, confirm your email so we can review your professional account application.</p>
        <p><a t-attf-href="{{ object.get_base_url() }}/pro-account/verify/{{ object.verification_token }}" style="background:#ff9ebe;color:#24191d;padding:12px 20px;text-decoration:none;font-weight:bold">Verify my email</a></p>
        <p>This secure link expires in 48 hours. Your account cannot be used until email verification and administrator approval are both complete.</p>
      </div>
    </field>
  </record>
  <record id="mail_template_pro_verified" model="mail.template">
    <field name="name">Starpil Pro: Email Verified</field>
    <field name="model_id" ref="model_starpil_pro_application"/>
    <field name="subject">Your email is verified — application under review</field>
    <field name="email_to">{{ object.email }}</field>
    <field name="body_html" type="html"><p>Hello <t t-out="object.name"/>, your email is verified. Our team will now review your professional details and certificate. We will email you when a decision is made.</p></field>
  </record>
  <record id="mail_template_pro_admin_review" model="mail.template">
    <field name="name">Starpil Pro: Admin Review Required</field>
    <field name="model_id" ref="model_starpil_pro_application"/>
    <field name="subject">New verified Pro application: {{ object.name }}</field>
    <field name="body_html" type="html"><p>A new verified professional application is ready for review.</p><ul><li>Name: <t t-out="object.name"/></li><li>Email: <t t-out="object.email"/></li><li>Business: <t t-out="object.business_name"/></li><li>Role: <t t-out="object.professional_role"/></li></ul></field>
  </record>
  <record id="mail_template_pro_approved" model="mail.template">
    <field name="name">Starpil Pro: Approved</field>
    <field name="model_id" ref="model_starpil_pro_application"/>
    <field name="subject">Welcome — your Starpil Pro account is approved</field>
    <field name="email_to">{{ object.email }}</field>
    <field name="body_html" type="html"><p>Hello <t t-out="object.name"/>, your professional account is approved. You can now sign in to view professional prices, shop, track orders and use Starpil Pro Rewards.</p><p><a t-attf-href="{{ object.get_base_url() }}/web/login">Sign in</a></p></field>
  </record>
  <record id="mail_template_pro_more_info" model="mail.template">
    <field name="name">Starpil Pro: More Information</field>
    <field name="model_id" ref="model_starpil_pro_application"/>
    <field name="subject">More information needed for your Starpil Pro application</field>
    <field name="email_to">{{ object.email }}</field>
    <field name="body_html" type="html"><p>Hello <t t-out="object.name"/>, we need more information before completing your application review.</p><p><t t-out="object.admin_notes"/></p></field>
  </record>
  <record id="mail_template_pro_rejected" model="mail.template">
    <field name="name">Starpil Pro: Not Approved</field>
    <field name="model_id" ref="model_starpil_pro_application"/>
    <field name="subject">Update on your Starpil Pro application</field>
    <field name="email_to">{{ object.email }}</field>
    <field name="body_html" type="html"><p>Hello <t t-out="object.name"/>, we are unable to approve this application at this time.</p><p><t t-out="object.admin_notes"/></p></field>
  </record>
</odoo>
