<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="starpil_customer_nav" name="Starpil Customer Navigation">
    <aside class="customer-nav">
      <div class="customer-nav-profile"><span class="customer-nav-avatar" t-out="(partner.name or 'SP')[:2].upper()"/><div><strong t-out="partner.name"/><small>Approved Starpil Pro</small></div></div>
      <nav class="customer-nav-links" aria-label="Customer account navigation">
        <a t-att-class="'is-active' if active == 'dashboard' else ''" href="/my/starpil"><i>⌂</i>Dashboard</a>
        <a t-att-class="'is-active' if active == 'orders' else ''" href="/my/starpil/orders"><i>□</i>Orders</a>
        <a t-att-class="'is-active' if active == 'invoices' else ''" href="/my/starpil/invoices"><i>▤</i>Invoices &amp; receipts</a>
        <a t-att-class="'is-active' if active == 'loyalty' else ''" href="/my/starpil/loyalty"><i>★</i>Pro Rewards</a>
        <small>Account</small>
        <a t-att-class="'is-active' if active == 'profile' else ''" href="/my/starpil/profile"><i>○</i>Business profile</a>
        <a href="/contact"><i>?</i>Support</a>
      </nav>
      <div class="customer-nav-signout"><a href="/web/session/logout?redirect=/">Sign out →</a></div>
    </aside>
  </template>

  <template id="starpil_customer_dashboard" name="Starpil Customer Dashboard">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="portal-main starpil-portal-live"><section class="portal-heading"><div><span class="kicker">My Starpil Pro</span><h1>Welcome back, <t t-out="partner.name"/>.</h1><p>Manage your professional orders, rewards and business account in one place.</p></div><a class="button button-dark" href="/starpil/shop">Shop professional products</a></section><div class="portal-layout"><t t-set="active" t-value="'dashboard'"/><t t-call="starpil_website.starpil_customer_nav"/><div class="portal-content">
        <section class="portal-summary-grid"><article class="portal-summary-card"><span>Available points</span><strong t-out="loyalty_account.points_balance if loyalty_account else 0"/><small>Live balance from your rewards wallet</small><a href="/my/starpil/loyalty">View rewards →</a></article><article class="portal-summary-card"><span>Membership tier</span><strong t-out="loyalty_account.tier_id.name if loyalty_account and loyalty_account.tier_id else 'Pro'"/><small t-if="loyalty_account and loyalty_account.tier_id"><t t-out="loyalty_account.tier_id.multiplier"/>× points rate</small><small t-else="">Approved professional account</small><a href="/my/starpil/loyalty">View tier benefits →</a></article><article class="portal-summary-card"><span>Open orders</span><strong t-out="open_order_count"/><small>Real-time Odoo order status</small><a href="/my/starpil/orders">Track orders →</a></article></section>
        <section class="portal-panel portal-loyalty-banner"><div class="portal-loyalty-copy"><span class="portal-label">Starpil Pro Rewards</span><h2>Your points travel with you.</h2><p>Earn on eligible paid orders, redeem online and present your digital member card for staff to scan in Odoo.</p><a class="button button-light" href="/my/starpil/loyalty">Open rewards wallet</a></div><div class="portal-mini-card"><span>PRO MEMBER</span><strong t-out="partner.name"/><p><t t-out="loyalty_account.points_balance if loyalty_account else 0"/> points</p><div class="portal-mini-code"/><small t-out="loyalty_account.member_code if loyalty_account else 'ACTIVATES WITH REWARDS'"/></div></section>
        <section class="portal-panel"><div class="portal-section-heading"><div><span>Recent orders</span><p>Live orders from your Odoo customer account.</p></div><a href="/my/starpil/orders">View all orders →</a></div><div t-if="orders" class="portal-order-list"><article t-foreach="orders" t-as="order"><div><small>Order</small><strong t-out="order.name"/></div><div><small>Placed</small><strong><span t-field="order.date_order" t-options='{"widget":"date"}'/></strong></div><div><small>Total · <t t-out="order.currency_id.name"/></small><strong><span t-field="order.amount_total" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><span t-att-class="'portal-status %s' % status_for(order)[1]" t-out="status_for(order)[0]"/><a t-att-href="'/my/starpil/orders/%s' % order.id">View →</a></article></div><div t-else="" class="portal-empty">No orders yet. Your first approved-account purchase will appear here immediately.</div></section>
        <section class="portal-dashboard-lower"><article class="portal-panel portal-quick-panel"><div class="portal-section-heading"><div><span>Quick actions</span><p>Shortcuts for your professional account.</p></div></div><div class="portal-quick-grid"><a href="/my/starpil/loyalty"><b>Digital member card</b><small>Open your scannable card</small></a><a href="/my/starpil/invoices"><b>Invoices &amp; receipts</b><small>Download account documents</small></a><a href="/my/starpil/profile"><b>Business profile</b><small>Manage contact and delivery details</small></a><a href="/contact"><b>Account support</b><small>Ask the Starpil team for help</small></a></div></article><article class="portal-panel portal-delivery-card"><span class="portal-label">Real-time account</span><h3>Odoo is working behind every screen.</h3><p>New products, stock, orders, invoices and payment status update without maintaining a second system.</p><a class="text-link" href="/starpil/shop">Shop catalogue ↗</a></article></section>
      </div></div></main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

  <template id="starpil_customer_orders" name="Starpil Customer Orders">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="portal-main starpil-portal-live"><section class="portal-heading"><div><span class="kicker">Order history</span><h1>My orders.</h1><p>Review and track your professional purchases in real time.</p></div><a class="button button-dark" href="/starpil/shop">Place a new order</a></section><div class="portal-layout"><t t-set="active" t-value="'orders'"/><t t-call="starpil_website.starpil_customer_nav"/><div class="portal-content"><section class="portal-panel portal-orders-panel"><div class="portal-section-heading portal-section-heading-padded"><div><span>All professional orders</span><p>Sales orders connected to your approved Odoo customer.</p></div><span><t t-out="len(orders)"/> orders</span></div><div class="portal-orders-table-wrap"><table class="portal-orders-table"><thead><tr><th>Order</th><th>Date</th><th>Items</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody><tr t-foreach="orders" t-as="order"><td><strong t-out="order.name"/><small t-out="order.carrier_id.name or 'Delivery not assigned'"/></td><td><span t-field="order.date_order" t-options='{"widget":"date"}'/></td><td><t t-out="len(order.order_line.filtered(lambda line: not line.display_type and not line.is_delivery))"/> products</td><td><strong><span t-field="order.amount_total" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></td><td><span t-att-class="'portal-status %s' % status_for(order)[1]" t-out="status_for(order)[0]"/></td><td><a t-att-href="'/my/starpil/orders/%s' % order.id">View order →</a></td></tr></tbody></table><div t-if="not orders" class="portal-empty">You have not placed an order yet.</div></div></section></div></div></main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

  <template id="starpil_customer_order_detail" name="Starpil Customer Order Detail">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="portal-main starpil-portal-live"><section class="portal-heading portal-detail-heading"><div><div class="breadcrumbs"><a href="/my/starpil">My account</a> / <a href="/my/starpil/orders">Orders</a> / <t t-out="order.name"/></div><span class="kicker">Order details</span><h1>Order <t t-out="order.name"/>.</h1><p>Placed <span t-field="order.date_order"/></p></div><div class="portal-heading-actions"><a t-if="order.invoice_ids" class="button button-outline" t-att-href="order.invoice_ids[:1].get_portal_url(report_type='pdf', download=True)">Download invoice</a><a class="button button-dark" href="/starpil/shop">Shop again</a></div></section><div class="portal-layout"><t t-set="active" t-value="'orders'"/><t t-call="starpil_website.starpil_customer_nav"/><div class="portal-content">
        <section class="portal-panel portal-tracking-card"><div class="portal-section-heading"><div><span>Order progress</span><p t-out="order.carrier_id.name or 'Delivery will be assigned by the Starpil team.'"/></div><span t-att-class="'portal-status %s' % status_for(order)[1]" t-out="status_for(order)[0]"/></div><div class="portal-tracking-line"><div class="is-complete"><span>✓</span><strong>Order placed</strong><small><span t-field="order.date_order" t-options='{"widget":"date"}'/></small></div><div t-att-class="'is-complete' if order.state in ('sale','done') else 'is-current'"><span t-out="'✓' if order.state in ('sale','done') else '•'"/><strong>Confirmed</strong><small t-out="'Complete' if order.state in ('sale','done') else 'Pending'"/></div><div t-att-class="'is-complete' if order.delivery_status in ('partial','full') else ('is-current' if order.state in ('sale','done') else '')"><span t-out="'✓' if order.delivery_status in ('partial','full') else '•'"/><strong>Prepared</strong><small t-out="'Stock processed' if order.delivery_status in ('partial','full') else 'Pending'"/></div><div t-att-class="'is-complete' if order.delivery_status == 'full' else ''"><span t-out="'✓' if order.delivery_status == 'full' else ''"/><strong>Dispatched</strong><small t-out="'Complete' if order.delivery_status == 'full' else 'Pending'"/></div><div t-att-class="'is-current' if order.state == 'done' else ''"><span t-out="'•' if order.state == 'done' else ''"/><strong>Complete</strong><small t-out="'Complete' if order.state == 'done' else 'Pending'"/></div></div></section>
        <div class="portal-order-detail-grid"><section class="portal-panel portal-line-items"><div class="portal-section-heading"><div><span>Items in this order</span><p>Live sale order lines.</p></div></div><article t-foreach="order.order_line.filtered(lambda line: not line.display_type and not line.is_delivery)" t-as="line"><div class="portal-item-image"><img t-att-src="'/web/image/product.product/%s/image_256' % line.product_id.id" t-att-alt="line.product_id.name"/></div><div><strong t-out="line.product_id.name"/><small>SKU <t t-out="line.product_id.default_code or '—'"/> · Quantity <t t-out="int(line.product_uom_qty)"/></small></div><strong><span t-field="line.price_subtotal" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></article></section><aside class="portal-panel portal-order-summary"><div class="portal-section-heading"><div><span>Order summary · <t t-out="order.currency_id.name"/></span><p t-out="order.invoice_status.replace('_',' ').title()"/></div></div><dl><div><dt>Subtotal</dt><dd><span t-field="order.amount_untaxed" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></dd></div><div><dt>Delivery</dt><dd><span t-field="order.amount_delivery" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></dd></div><div><dt>Taxes</dt><dd><span t-field="order.amount_tax" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></dd></div><div class="portal-total"><dt>Total</dt><dd><span t-field="order.amount_total" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></dd></div><div><dt>Points estimate</dt><dd class="portal-points-earned">+<t t-out="order.starpil_points_estimate"/> points</dd></div></dl></aside></div>
        <section class="portal-detail-info-grid"><article class="portal-panel"><div class="portal-section-heading"><div><span>Delivery address</span></div></div><p><strong t-out="order.partner_shipping_id.name"/><br/><t t-if="order.partner_shipping_id.street"><t t-out="order.partner_shipping_id.street"/><br/></t><t t-if="order.partner_shipping_id.street2"><t t-out="order.partner_shipping_id.street2"/><br/></t><t t-out="order.partner_shipping_id.city"/><t t-if="order.partner_shipping_id.country_id">, <t t-out="order.partner_shipping_id.country_id.name"/></t><br/><t t-out="order.partner_shipping_id.phone or order.partner_shipping_id.mobile"/></p></article><article class="portal-panel"><div class="portal-section-heading"><div><span>Payment &amp; documents</span></div></div><p><strong t-out="status_for(order.invoice_ids[:1])[0] if order.invoice_ids else 'Invoice pending'"/><br/><t t-out="order.invoice_ids[:1].name if order.invoice_ids else 'Your invoice will appear when created in Odoo.'"/></p><a t-if="order.invoice_ids" t-att-href="order.invoice_ids[:1].get_portal_url(report_type='pdf', download=True)">Download invoice ↓</a></article></section>
      </div></div></main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

  <template id="starpil_customer_invoices" name="Starpil Customer Invoices">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="portal-main starpil-portal-live"><section class="portal-heading"><div><span class="kicker">Account documents</span><h1>Invoices &amp; receipts.</h1><p>View billing status and download official Odoo documents for your business records.</p></div></section><div class="portal-layout"><t t-set="active" t-value="'invoices'"/><t t-call="starpil_website.starpil_customer_nav"/><div class="portal-content"><section class="portal-summary-grid portal-summary-two"><article class="portal-summary-card"><span>Paid documents · USD</span><strong><t t-out="len(invoices.filtered(lambda invoice: invoice.payment_state in ('paid','in_payment')))"/></strong><small>Payment-confirmed invoices and receipts</small></article><article class="portal-summary-card"><span>Amount due · USD</span><strong><span t-out="sum(invoices.mapped('amount_residual'))" t-options='{"widget":"monetary","display_currency":request.env.ref("base.USD")}'/></strong><small>Live outstanding balance</small></article></section><section class="portal-panel portal-orders-panel"><div class="portal-section-heading portal-section-heading-padded"><div><span>Billing history</span><p>Official invoices and payment receipts.</p></div></div><div class="portal-orders-table-wrap"><table class="portal-orders-table"><thead><tr><th>Invoice</th><th>Order</th><th>Date</th><th>Total</th><th>Payment status</th><th></th></tr></thead><tbody><tr t-foreach="invoices" t-as="invoice"><td><strong t-out="invoice.name"/></td><td t-out="invoice.invoice_origin or '—'"/><td><span t-field="invoice.invoice_date"/></td><td><strong><span t-field="invoice.amount_total" t-options='{"widget":"monetary","display_currency":invoice.currency_id}'/></strong></td><td><span t-att-class="'portal-status %s' % status_for(invoice)[1]" t-out="status_for(invoice)[0]"/></td><td><a t-att-href="invoice.get_portal_url(report_type='pdf', download=True)">Download PDF ↓</a></td></tr></tbody></table><div t-if="not invoices" class="portal-empty">No posted invoices are available yet.</div></div></section></div></div></main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

  <template id="starpil_customer_profile" name="Starpil Customer Profile">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="portal-main starpil-portal-live"><section class="portal-heading"><div><span class="kicker">Account settings</span><h1>Business profile.</h1><p>Keep your professional, contact and delivery information current.</p></div></section><div class="portal-layout"><t t-set="active" t-value="'profile'"/><t t-call="starpil_website.starpil_customer_nav"/><div class="portal-content portal-profile-layout"><form class="portal-panel portal-profile-form" action="/my/starpil/profile" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="portal-section-heading"><div><span>Business information</span><p>Your approved professional account details.</p></div><span class="portal-status status-complete">Pro approved</span></div><div t-if="saved" class="starpil-form-success">Your profile changes were saved.</div><div class="form-row"><div class="field"><label for="profile-name">Full name</label><input id="profile-name" name="name" t-att-value="partner.name" required="required"/></div><div class="field"><label for="profile-business">Company or salon</label><input id="profile-business" name="business_name" t-att-value="partner.starpil_business_name"/></div></div><div class="form-row"><div class="field"><label for="profile-email">Email address</label><input id="profile-email" name="email" type="email" t-att-value="partner.email" required="required"/></div><div class="field"><label for="profile-phone">Contact number</label><input id="profile-phone" name="phone" type="tel" t-att-value="partner.phone or partner.mobile" required="required"/></div></div><div class="portal-form-actions"><button class="button button-dark" type="submit">Save profile changes</button></div></form>
        <section class="portal-panel portal-address-panel"><div class="portal-section-heading"><div><span>Saved addresses</span><p>Used during your Starpil checkout.</p></div><a href="/starpil/checkout">Edit at checkout</a></div><article><div><span class="portal-address-label">Primary delivery</span><strong t-out="shipping_address.name"/><p><t t-out="shipping_address.street or 'Address not completed'"/><br/><t t-if="shipping_address.street2"><t t-out="shipping_address.street2"/><br/></t><t t-out="shipping_address.city or ''"/><t t-if="shipping_address.country_id">, <t t-out="shipping_address.country_id.name"/></t></p></div></article><article><div><span class="portal-address-label">Billing</span><strong t-out="invoice_address.name"/><p><t t-out="invoice_address.street or 'Address not completed'"/><br/><t t-out="invoice_address.city or ''"/><t t-if="invoice_address.country_id">, <t t-out="invoice_address.country_id.name"/></t></p></div></article></section>
        <section class="portal-panel portal-certificate-panel"><div class="portal-section-heading"><div><span>Professional certification</span><p>Reviewed during account approval.</p></div><span class="portal-status status-complete">Approved</span></div><div><span class="portal-document-icon">FILE</span><p><strong t-out="application.certificate_filename if application else 'Professional credential'"/><small t-out="'Verified by the Starpil team' if application else 'Approved account'"/></p></div></section>
        <section class="portal-panel portal-password-form"><div class="portal-section-heading"><div><span>Password &amp; security</span><p>Use Odoo's secure account controls to manage your login.</p></div></div><a class="button button-outline" href="/my/security">Open security settings</a></section>
      </div></div></main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>
</odoo>
