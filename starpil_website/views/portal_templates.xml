<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="starpil_customer_dashboard" name="Starpil Customer Dashboard">
    <t t-call="portal.portal_layout">
      <div class="container py-5 starpil-portal-dashboard">
        <span class="kicker">Approved professional account</span><h1>Welcome back, <t t-out="partner.name"/>.</h1>
        <div class="row g-3 my-4">
          <div class="col-md-4"><a class="card p-4 h-100 text-decoration-none" href="/my/orders"><small>Orders</small><strong class="fs-3" t-out="len(orders)"/><span>View order history →</span></a></div>
          <div class="col-md-4"><a class="card p-4 h-100 text-decoration-none" href="/my/invoices"><small>Invoices</small><strong class="fs-3" t-out="len(invoices)"/><span>View invoices →</span></a></div>
          <div class="col-md-4"><a class="card p-4 h-100 text-decoration-none" href="/my/starpil/loyalty"><small>Rewards</small><strong class="fs-3">Pro</strong><span>Points and digital card →</span></a></div>
        </div>
        <div class="d-flex gap-2 flex-wrap"><a class="btn btn-dark" href="/starpil/shop">Shop with Pro pricing</a><a class="btn btn-outline-dark" href="/my/account">Account details</a></div>
      </div>
    </t>
  </template>
</odoo>
