          <div t-if="home_categories" class="category-grid"><a t-foreach="home_categories" t-as="category" t-att-class="'category-card %s' % category._starpil_card_class()" t-att-href="'/starpil/shop?category=%s' % category.id"><img t-if="category.image_1920" t-att-src="'/web/image/product.public.category/%s/image_1920' % category.id" t-att-alt="category.name"/><div t-if="category.starpil_card_style == 'dark' and not category.image_1920" class="wax-orb wax-orb-white"/><div><small t-out="category.starpil_card_kicker or 'Professional collection'"/><h3 t-out="category.name"/><span>Explore collection →</span></div></a></div>
