<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="starpil_header" name="Starpil Header">
    <t t-set="header_categories" t-value="request.env['product.public.category'].sudo().search([('starpil_show_in_header','=',True),'|',('website_id','=',False),('website_id','=',request.website.id)], order='starpil_header_sequence, sequence, name')"/>
    <t t-set="starpil_header_approved" t-value="not request.env.user._is_public() and (request.env.user._is_internal() or request.env.user.partner_id._starpil_can_see_prices())"/>
    <t t-set="starpil_order" t-value="request.cart if starpil_header_approved else False"/>
    <div class="announcement">
      <div class="announcement-inner">
        <p>Professional-only pricing · <a href="/pro-account">Apply with your certification</a></p>
        <p class="announcement-location">Trinidad &amp; Tobago · Caribbean shipping available</p>
      </div>
    </div>
    <header class="site-header" id="site-header">
      <div class="header-inner">
        <button class="icon-button mobile-toggle" type="button" aria-label="Open navigation" data-starpil-mobile-open="">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <a class="brand" href="/" aria-label="Starpil Caribbean home"><img src="/starpil_website/static/src/img/starpil-wordmark.png" alt="Starpil Living Waxing"/></a>
        <nav class="main-nav" aria-label="Main navigation">
          <div class="nav-item">
            <a class="nav-link" href="/starpil/shop">Shop <span class="nav-chevron">⌄</span></a>
            <div class="mega-menu">
              <div class="mega-inner">
                <div class="mega-col">
                  <span>Wax collections</span>
                  <a t-foreach="header_categories[:4]" t-as="category" t-att-href="'/starpil/shop?category=%s' % category.id" t-out="category.name"/>
                </div>
                <div class="mega-col">
                  <span>Equipment &amp; care</span>
                  <a t-foreach="header_categories[4:8]" t-as="category" t-att-href="'/starpil/shop?category=%s' % category.id" t-out="category.name"/>
                  <a href="/starpil/shop">View All Products</a>
                </div>
                <div class="mega-col">
                  <span>Professional access</span>
                  <a href="/pro-account">Apply for Pro Access</a>
                  <a href="/web/login?redirect=/starpil/shop">Approved Pro Sign In</a>
                  <a href="/my/starpil">My Account</a>
                  <a href="/about">About Starpil</a>
                  <a href="/contact">Contact &amp; Support</a>
                </div>
                <a class="mega-feature" href="/starpil/shop">
                  <img src="/starpil_website/static/src/img/coral-collection.webp" alt="Coral wax collection"/>
                  <div><small>THE PROFESSIONAL COLLECTION</small><strong>Explore Starpil →</strong></div>
                </a>
              </div>
            </div>
          </div>
          <a t-foreach="header_categories[:4]" t-as="category" class="nav-link" t-att-href="'/starpil/shop?category=%s' % category.id" t-out="category.name"/>
          <a class="nav-link" href="/about">About</a>
          <a class="nav-link" href="/contact">Contact</a>
        </nav>
        <div class="header-actions">
          <a class="icon-button search-trigger" href="/starpil/shop" aria-label="Search products"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg></a>
          <a class="icon-button account-trigger" t-att-href="'/my/starpil' if not request.env.user._is_public() else '/web/login?redirect=/my/starpil'" aria-label="Professional account"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.8 21c.8-4 3.2-6 7.2-6s6.4 2 7.2 6"/></svg></a>
          <a class="icon-button bag-trigger" t-att-href="'/starpil/cart' if not request.env.user._is_public() else '/web/login?redirect=/starpil/cart'" aria-label="Shopping bag">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
            <span class="bag-count" t-out="int(starpil_order.cart_quantity) if starpil_order else 0"/>
          </a>
          <a class="header-pro" t-att-href="'/my/starpil' if not request.env.user._is_public() else '/pro-account'" t-out="'My Account' if not request.env.user._is_public() else 'Get Pro Access'"/>
        </div>
      </div>
    </header>
    <div class="header-spacer"/>
    <aside class="mobile-panel" aria-hidden="true" data-starpil-mobile-panel="">
      <div class="mobile-panel-top">
        <a href="/"><img src="/starpil_website/static/src/img/starpil-wordmark.png" alt="Starpil"/></a>
        <button class="icon-button mobile-close" type="button" aria-label="Close navigation" data-starpil-mobile-close=""><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
      </div>
      <div class="mobile-panel-body">
        <a class="mobile-main-link" href="/starpil/shop">Shop all <span>→</span></a>
        <div class="mobile-categories"><a t-foreach="header_categories" t-as="category" t-att-href="'/starpil/shop?category=%s' % category.id" t-out="category.name"/></div>
        <a class="mobile-main-link" href="/about">About Starpil <span>→</span></a>
        <a class="mobile-main-link" href="/pro-account">Pro Account <span>→</span></a>
        <a class="mobile-main-link" href="/my/starpil">My Account <span>→</span></a>
        <a class="mobile-main-link" href="/contact">Contact <span>→</span></a>
        <div class="mobile-actions">
          <a class="button button-dark" t-att-href="'/my/starpil' if not request.env.user._is_public() else '/web/login?redirect=/starpil/shop'" t-out="'My Dashboard' if not request.env.user._is_public() else 'Sign in to Pro Portal'"/>
          <a class="button button-outline" href="/pro-account">Apply for Pro Access</a>
        </div>
      </div>
    </aside>
    <div class="starpil-mobile-scrim" data-starpil-mobile-close=""/>
  </template>

  <template id="starpil_footer" name="Starpil Footer">
    <t t-set="header_categories" t-value="request.env['product.public.category'].sudo().search([('starpil_show_in_header','=',True),'|',('website_id','=',False),('website_id','=',request.website.id)], order='starpil_header_sequence, sequence, name')"/>
    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-brand">
          <img src="/starpil_website/static/src/img/starpil-logo.png" alt="Starpil Living Waxing"/>
          <p>Premium professional waxing products, equipment and treatment essentials for certified beauty professionals across Trinidad &amp; Tobago and the Caribbean.</p>
          <div class="footer-contact"><a href="mailto:info@starpilwaxtt.com">info@starpilwaxtt.com</a></div>
        </div>
        <div class="footer-col"><h3>Shop</h3><a t-foreach="header_categories" t-as="category" t-att-href="'/starpil/shop?category=%s' % category.id" t-out="category.name"/><a href="/starpil/shop">All products</a></div>
        <div class="footer-col"><h3>Professional account</h3><a href="/pro-account">Apply for Pro Access</a><a href="/web/login?redirect=/my/starpil">Sign In</a><a href="/my/starpil">My Account</a><a href="/my/starpil/loyalty">Pro Rewards</a></div>
        <div class="footer-col"><h3>Customer care</h3><a href="/about">About Starpil</a><a href="/contact">Contact Us</a><a href="/starpil/shop">Professional Catalogue</a><a href="https://www.instagram.com/starpilwaxtt/" target="_blank" rel="noopener">Instagram ↗</a></div>
      </div>
      <div class="footer-bottom"><span>© 2026 Starpil Caribbean. All rights reserved.</span><div><span>Trinidad &amp; Tobago</span><span>USD professional pricing</span></div></div>
    </footer>
  </template>

  <template id="starpil_product_card" name="Starpil Product Card">
    <article class="product-card">
      <div class="product-image">
        <span t-if="product.starpil_website_badge" class="product-badge" t-out="product.starpil_website_badge"/>
        <a class="product-image-link" t-att-href="'/starpil/product/%s' % slug(product)" t-att-aria-label="'View %s' % product.name"><img t-att-src="'/web/image/product.template/%s/image_1024' % product.id" t-att-alt="product.name" loading="lazy"/></a>
        <a class="product-quick" t-att-href="'/starpil/product/%s' % slug(product)" t-out="'View &amp; purchase' if approved else 'View product'"/>
      </div>
      <div class="product-meta" t-out="product.public_categ_ids[:1].name or 'Professional Waxing'"/>
      <h3><a t-att-href="'/starpil/product/%s' % slug(product)" t-out="product.name"/></h3>
      <t t-if="approved">
        <div class="approved-card-price">
          <strong><span t-out="product._starpil_website_price(request.env.user.partner_id, pricelist=pricelist)" t-options='{"widget":"monetary","display_currency":pricelist.currency_id}'/></strong>
          <span t-out="'In stock' if product.qty_available &gt; 0 else 'Check availability'"/>
        </div>
        <small class="starpil-card-points">Earn approximately <b t-out="product._starpil_estimated_points(request.env.user.partner_id, 1.0, pricelist=pricelist)"/> points</small>
      </t>
      <a t-else="" class="locked-price" t-att-href="'/web/login?redirect=/starpil/product/%s' % slug(product)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="1"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        Sign in to see price
      </a>
    </article>
  </template>

  <template id="starpil_homepage" name="Starpil Caribbean Homepage">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/>
      <t t-call="starpil_website.starpil_header"/>
      <main class="starpil-odoo-storefront">
