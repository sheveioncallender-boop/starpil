        </section>

        <section class="section products-section"><div class="section-heading section-heading-row"><div><span class="kicker">Professional favourites</span><h2>Best sellers</h2></div><div class="product-tabs"><a class="is-active" href="/starpil/shop">All</a><a t-foreach="header_categories[:4]" t-as="category" t-att-href="'/starpil/shop?category=%s' % category.id" t-out="category.name"/></div></div><div class="product-grid"><t t-foreach="products" t-as="product"><t t-call="starpil_website.starpil_product_card"/></t><div t-if="not products" class="starpil-empty-catalogue"><h3>Your live catalogue is ready.</h3><p>Publish products from the Starpil Website tab in Odoo and they will appear here immediately.</p></div></div><div class="centered-action"><a class="button button-outline" href="/starpil/shop">View all professional products</a></div></section>

