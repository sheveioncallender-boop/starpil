  <template id="starpil_about" name="About Starpil Caribbean">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="starpil-odoo-storefront">
        <section class="page-hero page-hero-image"><img src="/starpil_website/static/src/img/gold-soft-wax.webp" alt="Starpil professional wax products"/><div><div class="breadcrumbs"><a href="/">Home</a> / About</div><span class="kicker kicker-light">The brand behind the wax</span><h1>Professional waxing,<br/>without compromise.</h1><p>Global product expertise, supplied with the local access and support Caribbean beauty professionals need.</p></div></section>
        <section class="story-intro"><span class="kicker">Waxing at its finest</span><h2>Born in Spain.<br/>Trusted around the world.</h2><p>Starpil originated in Tarragona, Spain and has grown into one of the professional beauty industry's most recognized waxing brands—known for advanced formulas, dependable equipment and complete pre- and post-treatment systems.</p></section>
        <section class="story-grid"><div class="story-image"><img src="/starpil_website/static/src/img/coral-collection.webp" alt="Starpil Coral wax collection"/></div><div class="story-copy"><span class="kicker">The products</span><h2>Formulas made for working professionals.</h2><p>From flagship Blue, Pink and Starsoft formulas to professional warmers and treatment essentials, each collection is designed to help estheticians work efficiently while creating a more comfortable client experience.</p><p>Starpil Caribbean brings that professional system closer to home with authentic supply, protected Pro pricing and support for certified practitioners.</p><div class="stats-row"><div><strong>30+</strong><span>Years of expertise</span></div><div><strong>65+</strong><span>Countries supplied</span></div><div><strong>100%</strong><span>Professional focus</span></div></div></div></section>
        <section class="section"><div class="section-heading"><div><span class="kicker">The Caribbean difference</span><h2>Global standards.<br/>Local relationships.</h2></div><p>Running a treatment business is demanding. Starpil Caribbean makes professional product access, guidance and replenishment simpler for the region's estheticians and salon owners.</p></div><div class="process-grid"><article class="process-card"><h3>Authentic supply</h3><p>Professional Starpil products supplied for the Trinidad &amp; Tobago and Caribbean market.</p></article><article class="process-card"><h3>Responsive support</h3><p>Help choosing formulas, understanding product use and resolving order questions.</p></article><article class="process-card"><h3>Regional fulfilment</h3><p>Domestic delivery, local pickup options and international shipping through configured Odoo delivery methods.</p></article></div></section>
        <section class="newsletter"><div><span class="kicker kicker-light">Join the professional community</span><h2>Bring Starpil into your treatment room.</h2></div><div class="hero-actions"><a class="button button-light" href="/pro-account">Apply for Pro Access</a><a class="text-link text-link-light" href="/starpil/shop">Explore products ↗</a></div></section>
      </main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

  <template id="starpil_contact" name="Contact Starpil Caribbean">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="starpil-odoo-storefront">
        <section class="page-hero"><div><div class="breadcrumbs"><a href="/">Home</a> / Contact</div><span class="kicker">Professional support</span><h1>How can we help?</h1><p>Questions about an account, a formula, an order or delivery? Speak with the Starpil Caribbean team.</p></div></section>
        <section class="contact-layout"><div class="contact-details"><span class="kicker">Connect with us</span><h2>Real support for working professionals.</h2><p>Our customer service team is available Monday to Friday, 9:00 AM–5:00 PM.</p><div class="contact-list"><div><small>Telephone &amp; WhatsApp</small><a href="tel:+18683022382">+1 (868) 302-2382</a></div><div><small>Email</small><a href="mailto:info@starpilwaxtt.com">info@starpilwaxtt.com</a></div><div><small>Instagram</small><a href="https://www.instagram.com/starpilwaxtt/" target="_blank" rel="noopener">@starpilwaxtt ↗</a></div><div><small>Market</small><strong>Trinidad &amp; Tobago · Caribbean</strong></div></div></div><form class="contact-form" action="/starpil/contact/submit" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><span class="kicker">Send an inquiry</span><h2>Tell us what you need.</h2><div t-if="sent" class="starpil-form-success">Thank you. Your inquiry has been sent to the Starpil team.</div><div t-if="error" class="starpil-form-error" t-out="error"/><div class="form-row"><div class="field"><label for="contact-full-name">Full name</label><input id="contact-full-name" name="name" required="required" t-att-value="form.get('name','')"/></div><div class="field"><label for="contact-phone">Phone number</label><input id="contact-phone" name="phone" type="tel" required="required" t-att-value="form.get('phone','')"/></div></div><div class="field"><label for="contact-email">Email address</label><input id="contact-email" name="email" type="email" required="required" t-att-value="form.get('email','')"/></div><div class="field"><label for="contact-subject">Subject</label><select id="contact-subject" name="subject"><option>Professional account</option><option>Product guidance</option><option>Existing order</option><option>Shipping and delivery</option><option>General inquiry</option></select></div><div class="field"><label for="contact-message">Message</label><textarea id="contact-message" name="message" required="required"><t t-out="form.get('message','')"/></textarea></div><button class="button button-dark" type="submit">Send message</button></form></section>
        <section class="section" id="faq"><div class="section-heading"><div><span class="kicker">Frequently asked</span><h2>Professional ordering,<br/>made clearer.</h2></div><p>Protected prices, live Odoo ordering and local support are presented through one consistent Starpil experience.</p></div><div class="process-grid"><article class="process-card"><h3>Why are prices hidden?</h3><p>Starpil products and professional prices are available only to certified professionals with an approved account.</p></article><article class="process-card" id="shipping"><h3>How is delivery handled?</h3><p>Available delivery and pickup choices are calculated in real time from the methods configured in Odoo.</p></article><article class="process-card" id="returns"><h3>How do I report an issue?</h3><p>Contact the customer service team with your order number within seven business days for lost or damaged packages.</p></article></div></section>
      </main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

  <template id="starpil_shop" name="Starpil Pro Shop">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="starpil-odoo-storefront"><section class="page-hero page-hero-image"><img src="/starpil_website/static/src/img/soft-wax-collection.webp" alt="Starpil professional wax collection"/><div><div class="breadcrumbs"><a href="/">Home</a> / Shop</div><span class="kicker kicker-light">Professional catalogue</span><h1>Tools for better<br/>treatment rooms.</h1><p t-if="approved">Your approved USD professional pricelist, live stock and points estimates are active.</p><p t-else="">Browse the full product structure. Prices and purchasing remain locked until your certification is reviewed and your account is approved.</p></div></section><section class="shop-shell"><div class="shop-toolbar"><form class="shop-search" action="/starpil/shop" method="get"><label class="sr-only" for="starpil-shop-search">Search products</label><input id="starpil-shop-search" type="search" name="search" t-att-value="search" placeholder="Search professional products"/><button type="submit" aria-label="Search">⌕</button></form><div class="shop-filter" aria-label="Filter products"><a t-att-class="'is-active' if not selected_category else ''" href="/starpil/shop">All products</a><a t-foreach="categories" t-as="category" t-att-class="'is-active' if selected_category and selected_category.id == category.id else ''" t-att-href="'/starpil/shop?category=%s' % category.id" t-out="category.name"/></div></div><p class="shop-count"><t t-out="len(products)"/> professional product<t t-if="len(products) != 1">s</t><t t-if="approved"> · Approved account pricing</t></p><div class="product-grid"><t t-foreach="products" t-as="product"><t t-call="starpil_website.starpil_product_card"/></t><div t-if="not products" class="starpil-empty-catalogue"><h3>No products found.</h3><p>Try another collection or search term.</p></div></div></section><section t-if="not approved" class="newsletter"><div><span class="kicker kicker-light">Certified professional?</span><h2>Unlock your professional catalogue.</h2></div><div class="hero-actions"><a class="button button-light" href="/pro-account">Apply for Pro Access</a><a class="text-link text-link-light" href="/web/login?redirect=/starpil/shop">Already approved? Sign in ↗</a></div></section></main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

  <template id="starpil_product" name="Starpil Product">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="starpil-odoo-storefront"><section class="product-detail"><div class="product-layout"><div class="product-gallery"><div class="product-main-image"><img t-att-src="'/web/image/product.template/%s/image_1920' % product.id" t-att-alt="product.name"/></div></div><div class="product-info"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/starpil/shop">Shop</a> / <t t-out="product.public_categ_ids[:1].name or 'Professional'"/></div><div class="product-meta" t-out="product.starpil_website_badge or product.public_categ_ids[:1].name or 'Professional collection'"/><h1 t-out="product.name"/><t t-if="approved"><div class="product-status product-status-unlocked"><div class="visible-price"><small>Professional price · <t t-out="price_currency.name"/></small><strong><span t-out="price" t-options='{"widget":"monetary","display_currency":price_currency}'/></strong></div><span t-if="product.starpil_show_stock" class="stock-status" t-out="'In stock' if product.qty_available &gt; 0 else 'Contact us for availability'"/></div><div class="product-points-preview" data-starpil-points-calculator="" t-att-data-unit-points="estimated_points"><span>★</span><p><strong>Earn approximately <b data-points-output="" t-out="estimated_points"/> points</strong><small>Your current tier and quantity · Posted after successful payment</small></p></div></t><div t-else="" class="product-status"><a class="locked-price" t-att-href="'/web/login?redirect=/starpil/product/%s' % slug(product)">🔒 Sign in to see price</a><span>Professional account required</span></div><div t-if="product.starpil_website_description" t-field="product.starpil_website_description"/><p t-else="" t-out="product.description_sale"/><form t-if="approved" action="/starpil/cart/add" method="post" class="product-purchase product-purchase-unlocked"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="product_tmpl_id" t-att-value="product.id"/><div class="purchase-summary"><strong>Ready for your treatment room.</strong><p>Live Odoo price, stock and points are active for this approved account.</p></div><div class="purchase-controls"><input class="starpil-quantity-input" type="number" name="quantity" min="1" max="99" value="1" aria-label="Quantity"/><button class="button button-dark" type="submit">Add to cart</button></div></form><div t-else="" class="product-purchase"><strong>Professional pricing is protected.</strong><p>Sign in with an approved account to view your USD price, stock availability, points and ordering options.</p><a class="button button-dark" t-att-href="'/web/login?redirect=/starpil/product/%s' % slug(product)">Sign in to purchase</a></div><div class="product-spec"><div><span>SKU</span><strong t-out="product.default_code or 'Starpil Professional'"/></div><div><span>Stock</span><strong t-out="'Live in Odoo' if approved else 'Unlock after approval'"/></div><div><span>Access</span><strong>Approved professionals</strong></div><div><span>Collection</span><strong t-out="product.public_categ_ids[:1].name or 'Professional'"/></div></div></div></div></section></main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

  <template id="starpil_cart" name="Starpil Pro Cart">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="starpil-live-site starpil-live-section"><div class="starpil-shop-title"><span class="kicker">Approved account</span><h1>Your Pro cart.</h1><p>Prices and totals use the live Odoo order in USD.</p></div><div t-if="not order or not order.order_line" class="starpil-live-empty"><h2>Your cart is empty.</h2><a class="button button-dark" href="/starpil/shop">Shop professional products</a></div><div t-else="" class="starpil-live-cart-layout"><section class="starpil-live-cart-lines"><article t-foreach="order.order_line.filtered(lambda l: not l.display_type and not l.is_delivery)" t-as="line" class="starpil-live-cart-line"><img t-att-src="'/web/image/product.product/%s/image_256' % line.product_id.id" t-att-alt="line.product_id.name"/><div><small t-out="line.product_id.default_code or 'Starpil Professional'"/><h2 t-out="line.product_id.name"/><strong><span t-field="line.price_unit" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><form action="/starpil/cart/update" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="line_id" t-att-value="line.id"/><input type="number" name="quantity" min="0" max="99" t-att-value="int(line.product_uom_qty)"/><button type="submit">Update</button></form><strong><span t-field="line.price_subtotal" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></article></section><aside class="starpil-live-summary"><span class="kicker">Order summary</span><h2>Pro Cart</h2><div><span>Subtotal</span><strong><span t-field="order.amount_untaxed" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><div><span>Taxes</span><strong><span t-field="order.amount_tax" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><div class="starpil-live-total"><span>Total</span><strong><span t-field="order.amount_total" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><div class="starpil-points-box"><span>★</span><p><strong>Earn approximately <b t-out="order.starpil_points_estimate"/> points</strong><small>Posted after successful payment</small></p></div><a class="button button-dark" href="/starpil/checkout">Proceed to secure checkout</a></aside></div></main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

  <template id="starpil_checkout" name="Starpil One-Page Checkout">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="starpil-odoo-storefront starpil-checkout-page">
        <section class="checkout-heading"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/starpil/cart">Cart</a> / Checkout</div><span class="kicker">Secure professional checkout</span><h1>Complete your order.</h1><div class="checkout-progress" aria-label="Checkout progress"><span class="is-current">Customer &amp; delivery</span><span class="is-current">Payment</span><span>Confirmation</span></div></section>
        <section class="checkout-shell">
          <div class="checkout-form">
            <section class="checkout-card">
              <div class="checkout-card-heading"><span>Delivery address</span><p>Saved immediately to this Odoo order and your customer account.</p></div>
              <form action="/shop/address/submit" method="post" data-starpil-address-form="">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="partner_id" t-att-value="shipping_partner.id"/><input type="hidden" name="address_type" value="delivery"/><input type="hidden" name="callback" value="/starpil/checkout"/>
                <div class="form-row"><div class="field"><label for="shipping-name">Full name</label><input id="shipping-name" name="name" required="required" t-att-value="shipping_partner.name"/></div><div class="field"><label for="shipping-phone">Phone number</label><input id="shipping-phone" name="phone" type="tel" required="required" t-att-value="shipping_partner.phone or shipping_partner.mobile"/></div></div>
                <div class="field"><label for="shipping-email">Email address</label><input id="shipping-email" name="email" type="email" required="required" t-att-value="shipping_partner.email"/></div>
                <div class="field"><label for="shipping-street">Street address</label><input id="shipping-street" name="street" required="required" t-att-value="shipping_partner.street"/></div>
                <div class="form-row"><div class="field"><label for="shipping-street2">Apartment, suite or area</label><input id="shipping-street2" name="street2" t-att-value="shipping_partner.street2"/></div><div class="field"><label for="shipping-city">City</label><input id="shipping-city" name="city" required="required" t-att-value="shipping_partner.city"/></div></div>
                <div class="form-row"><div class="field"><label for="shipping-country">Country</label><select id="shipping-country" name="country_id" required="required"><option value="">Select country</option><option t-foreach="countries" t-as="country" t-att-value="country.id" t-att-selected="shipping_partner.country_id == country" t-out="country.name"/></select></div><div class="field"><label for="shipping-zip">Postal code</label><input id="shipping-zip" name="zip" t-att-value="shipping_partner.zip"/></div></div>
                <label class="application-consent"><input type="checkbox" name="use_delivery_as_billing" value="true" t-att-checked="use_delivery_as_billing"/><span>Use this delivery address as my billing address.</span></label>
                <div class="starpil-address-feedback" data-starpil-address-feedback="" aria-live="polite"/>
                <button class="button button-outline" type="submit">Save delivery address</button>
              </form>
            </section>

            <section class="checkout-card">
              <div class="checkout-card-heading"><span>Billing address</span><p t-if="use_delivery_as_billing">Currently the same as your delivery address. Submit this form only if billing should be different.</p><p t-else="">This separate address is used for billing and payment checks.</p></div>
              <form action="/shop/address/submit" method="post" data-starpil-address-form="">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="partner_id" t-att-value="'' if use_delivery_as_billing else billing_partner.id"/><input type="hidden" name="address_type" value="billing"/><input type="hidden" name="callback" value="/starpil/checkout"/>
                <div class="form-row"><div class="field"><label for="billing-name">Full name</label><input id="billing-name" name="name" required="required" t-att-value="billing_partner.name"/></div><div class="field"><label for="billing-phone">Phone number</label><input id="billing-phone" name="phone" type="tel" required="required" t-att-value="billing_partner.phone or billing_partner.mobile"/></div></div>
                <div class="field"><label for="billing-email">Email address</label><input id="billing-email" name="email" type="email" required="required" t-att-value="billing_partner.email"/></div>
                <div class="field"><label for="billing-street">Street address</label><input id="billing-street" name="street" required="required" t-att-value="billing_partner.street"/></div>
                <div class="form-row"><div class="field"><label for="billing-city">City</label><input id="billing-city" name="city" required="required" t-att-value="billing_partner.city"/></div><div class="field"><label for="billing-country">Country</label><select id="billing-country" name="country_id" required="required"><option value="">Select country</option><option t-foreach="countries" t-as="country" t-att-value="country.id" t-att-selected="billing_partner.country_id == country" t-out="country.name"/></select></div></div>
                <input type="hidden" name="street2" t-att-value="billing_partner.street2 or ''"/><input type="hidden" name="zip" t-att-value="billing_partner.zip or ''"/>
                <div class="starpil-address-feedback" data-starpil-address-feedback="" aria-live="polite"/>
                <button class="button button-outline" type="submit">Save billing address</button>
              </form>
            </section>

            <section class="checkout-card">
              <div class="checkout-card-heading"><span>Delivery method</span><p>Live delivery choices and custom fees configured in Odoo.</p></div>
              <div t-if="not address_ready" class="starpil-checkout-notice">Save a complete delivery and billing address to calculate delivery choices.</div>
              <div t-elif="order._has_deliverable_products() and delivery_quotes" class="option-grid">
                <form t-foreach="delivery_quotes" t-as="quote" action="/starpil/checkout/delivery" method="post">
                  <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="carrier_id" t-att-value="quote['carrier'].id"/>
                  <button type="submit" t-att-class="'checkout-option starpil-delivery-option %s' % ('is-selected' if order.carrier_id == quote['carrier'] else '')" t-att-disabled="not quote['success']"><span class="starpil-option-radio"/><span><strong t-out="quote['carrier'].name"/><small t-out="quote['carrier'].website_description or 'Delivery option configured in Odoo'"/></span><em t-if="quote['success']"><span t-out="quote['price']" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></em><em t-else="" t-out="quote['error'] or 'Unavailable'"/></button>
                </form>
              </div>
              <div t-elif="order._has_deliverable_products()" class="starpil-checkout-notice">No delivery method is available for this address. Please contact Starpil support.</div>
              <div t-else="" class="starpil-checkout-success">No delivery is required for this service-only order.</div>
            </section>

            <section class="checkout-card starpil-payment-card">
              <div class="checkout-card-heading"><span>Payment</span><p>Choose from the live providers enabled in Odoo.</p></div>
              <div t-if="not payment_ready" class="starpil-checkout-notice">Complete the address and delivery sections before choosing payment.</div>
              <t t-else="">
                <div t-if="errors" class="starpil-form-error"><strong>Payment is not ready</strong><p>Please review the address, delivery method and active Odoo payment-provider configuration.</p></div>
                <div id="payment_method" class="o_not_editable starpil-native-payment-form"><t t-call="payment.form"/></div>
              </t>
            </section>
          </div>

          <aside class="checkout-summary"><div class="checkout-summary-inner"><span class="kicker">Your order</span><h2>Checkout summary</h2><div class="checkout-summary-items"><article t-foreach="order.order_line.filtered(lambda line: not line.display_type and not line.is_delivery)" t-as="line" class="checkout-summary-item"><div><img t-att-src="'/web/image/product.product/%s/image_256' % line.product_id.id" t-att-alt="line.product_id.name"/><span t-out="int(line.product_uom_qty)"/></div><p><strong t-out="line.product_id.name"/><small t-out="line.product_id.default_code or 'Starpil Professional'"/></p><em><span t-field="line.price_subtotal" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></em></article></div><form action="/starpil/loyalty/coupon/apply" method="post" class="checkout-promo"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input name="code" placeholder="Reward or promotion code"/><button type="submit">Apply</button></form><small t-if="coupon_applied" class="starpil-inline-success">Reward coupon applied.</small><small t-if="coupon_error" class="starpil-inline-error">This coupon is invalid, expired or does not meet its minimum order.</small><div class="summary-row"><span>Subtotal</span><strong><span t-field="order.amount_untaxed" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><div class="summary-row"><span>Delivery</span><strong><span t-field="order.amount_delivery" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><div class="summary-row"><span>Taxes</span><strong><span t-field="order.amount_tax" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><div class="summary-row summary-total"><span>Total · <t t-out="order.currency_id.name"/></span><strong><span t-field="order.amount_total" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><div class="checkout-points-preview"><span>★</span><p><strong>Earn approximately <b t-out="order.starpil_points_estimate"/> points</strong><small>Posted after Odoo confirms successful payment</small></p></div><div class="checkout-confidence"><span>✓ Approved professional pricing</span><span>✓ Live stock, delivery and payment</span><span>✓ One Starpil checkout experience</span></div><a class="starpil-return-link" href="/starpil/cart">← Return to cart</a></div></aside>
        </section>
      </main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

  <template id="starpil_order_confirmation" name="Starpil Order Confirmation">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="order-confirmation-main"><section class="order-confirmation-card"><div class="order-confirmation-mark">✓</div><span class="kicker">Order received</span><h1>Thank you,<br/><em><t t-out="order.partner_id.name"/>.</em></h1><p>Your professional order has been created. Its live payment and fulfilment status is available from your Starpil dashboard.</p><div class="order-confirmation-reference"><div><small>Order number</small><strong t-out="order.name"/></div><div><small>Order total · <t t-out="order.currency_id.name"/></small><strong><span t-field="order.amount_total" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><div><small>Points <t t-out="'posted' if points_posted else 'pending'"/></small><strong>+<t t-out="points_display"/></strong></div></div><div t-att-class="'order-confirmation-status %s' % ('is-paid' if payment_confirmed else '')"><span/><div><strong t-out="'Payment confirmed' if payment_confirmed else 'Payment is being confirmed'"/><p t-out="'Your order payment is confirmed. Loyalty points post according to the active program rules.' if payment_confirmed else 'Odoo is monitoring the payment. Points will post after successful payment.'"/></div></div><div class="order-confirmation-actions"><a class="button button-dark" t-att-href="'/my/starpil/orders/%s' % order.id">View order details</a><a class="button button-outline" href="/my/starpil">Return to dashboard</a></div><small class="order-confirmation-help">Need help with this order? <a href="/contact">Contact Starpil support</a>.</small></section></main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

