<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="starpil_header" name="Starpil Header">
    <t t-set="header_categories" t-value="request.env['product.public.category'].sudo().search([('starpil_show_in_header','=',True),'|',('website_id','=',False),('website_id','=',request.website.id)], order='starpil_header_sequence, sequence, name')"/>
    <t t-set="starpil_header_approved" t-value="not request.env.user._is_public() and (request.env.user._is_internal() or request.env.user.partner_id._starpil_can_see_prices())"/>
    <t t-set="starpil_order" t-value="request.cart if starpil_header_approved else False"/>
    <div class="announcement">
      <div class="announcement-inner">
        <p>Professional-only pricing · <a href="/pro-account">Apply with your certification</a></p>
        <p class="announcement-location">Trinidad &amp; Tobago · Caribbean shipping available</p>
      </div>
    </div>
    <header class="site-header" id="site-header">
      <div class="header-inner">
        <button class="icon-button mobile-toggle" type="button" aria-label="Open navigation" data-starpil-mobile-open="">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
        <a class="brand" href="/" aria-label="Starpil Caribbean home"><img src="/starpil_website/static/src/img/starpil-wordmark.png" alt="Starpil Living Waxing"/></a>
        <nav class="main-nav" aria-label="Main navigation">
          <div class="nav-item">
            <a class="nav-link" href="/starpil/shop">Shop <span class="nav-chevron">⌄</span></a>
            <div class="mega-menu">
              <div class="mega-inner">
                <div class="mega-col">
                  <span>Wax collections</span>
                  <a t-foreach="header_categories[:4]" t-as="category" t-att-href="'/starpil/shop?category=%s' % category.id" t-out="category.name"/>
                </div>
                <div class="mega-col">
                  <span>Equipment &amp; care</span>
                  <a t-foreach="header_categories[4:8]" t-as="category" t-att-href="'/starpil/shop?category=%s' % category.id" t-out="category.name"/>
                  <a href="/starpil/shop">View All Products</a>
                </div>
                <div class="mega-col">
                  <span>Professional access</span>
                  <a href="/pro-account">Apply for Pro Access</a>
                  <a href="/web/login?redirect=/starpil/shop">Approved Pro Sign In</a>
                  <a href="/my/starpil">My Account</a>
                  <a href="/contactus">Contact &amp; Support</a>
                </div>
                <a class="mega-feature" href="/starpil/shop">
                  <img src="/starpil_website/static/src/img/coral-collection.webp" alt="Coral wax collection"/>
                  <div><small>THE PROFESSIONAL COLLECTION</small><strong>Explore Starpil →</strong></div>
                </a>
              </div>
            </div>
          </div>
          <a t-foreach="header_categories[:4]" t-as="category" class="nav-link" t-att-href="'/starpil/shop?category=%s' % category.id" t-out="category.name"/>
          <a class="nav-link" href="/contactus">Contact</a>
        </nav>
        <div class="header-actions">
          <a class="icon-button" href="/starpil/shop" aria-label="Search products"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg></a>
          <a class="icon-button" t-att-href="'/my/starpil' if not request.env.user._is_public() else '/web/login?redirect=/my/starpil'" aria-label="Professional account"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.8 21c.8-4 3.2-6 7.2-6s6.4 2 7.2 6"/></svg></a>
          <a class="icon-button bag-trigger" t-att-href="'/starpil/cart' if not request.env.user._is_public() else '/web/login?redirect=/starpil/cart'" aria-label="Shopping bag">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
            <span class="bag-count" t-out="int(starpil_order.cart_quantity) if starpil_order else 0"/>
          </a>
          <a class="header-pro" t-att-href="'/my/starpil' if not request.env.user._is_public() else '/pro-account'" t-out="'My Account' if not request.env.user._is_public() else 'Get Pro Access'"/>
        </div>
      </div>
    </header>
    <div class="header-spacer"/>
    <aside class="mobile-panel" aria-hidden="true" data-starpil-mobile-panel="">
      <div class="mobile-panel-top">
        <a href="/"><img src="/starpil_website/static/src/img/starpil-wordmark.png" alt="Starpil"/></a>
        <button class="icon-button mobile-close" type="button" aria-label="Close navigation" data-starpil-mobile-close=""><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
      </div>
      <div class="mobile-panel-body">
        <a class="mobile-main-link" href="/starpil/shop">Shop all <span>→</span></a>
        <div class="mobile-categories"><a t-foreach="header_categories" t-as="category" t-att-href="'/starpil/shop?category=%s' % category.id" t-out="category.name"/></div>
        <a class="mobile-main-link" href="/pro-account">Pro Account <span>→</span></a>
        <a class="mobile-main-link" href="/my/starpil">My Account <span>→</span></a>
        <a class="mobile-main-link" href="/contactus">Contact <span>→</span></a>
        <div class="mobile-actions">
          <a class="button button-dark" t-att-href="'/my/starpil' if not request.env.user._is_public() else '/web/login?redirect=/starpil/shop'" t-out="'My Dashboard' if not request.env.user._is_public() else 'Sign in to Pro Portal'"/>
          <a class="button button-outline" href="/pro-account">Apply for Pro Access</a>
        </div>
      </div>
    </aside>
    <div class="starpil-mobile-scrim" data-starpil-mobile-close=""/>
  </template>

  <template id="starpil_footer" name="Starpil Footer">
    <t t-set="header_categories" t-value="request.env['product.public.category'].sudo().search([('starpil_show_in_header','=',True),'|',('website_id','=',False),('website_id','=',request.website.id)], order='starpil_header_sequence, sequence, name')"/>
    <footer class="site-footer">
      <div class="footer-main">
        <div class="footer-brand">
          <img src="/starpil_website/static/src/img/starpil-logo.png" alt="Starpil Living Waxing"/>
          <p>Premium professional waxing products, equipment and treatment essentials for certified beauty professionals across Trinidad &amp; Tobago and the Caribbean.</p>
          <div class="footer-contact"><a href="mailto:info@starpilwaxtt.com">info@starpilwaxtt.com</a></div>
        </div>
        <div class="footer-col"><h3>Shop</h3><a t-foreach="header_categories" t-as="category" t-att-href="'/starpil/shop?category=%s' % category.id" t-out="category.name"/><a href="/starpil/shop">All products</a></div>
        <div class="footer-col"><h3>Professional account</h3><a href="/pro-account">Apply for Pro Access</a><a href="/web/login?redirect=/my/starpil">Sign In</a><a href="/my/starpil">My Account</a><a href="/my/starpil/loyalty">Pro Rewards</a></div>
        <div class="footer-col"><h3>Customer care</h3><a href="/contactus">Contact Us</a><a href="/starpil/shop">Professional Catalogue</a><a href="https://www.instagram.com/starpilwaxtt/" target="_blank" rel="noopener">Instagram ↗</a></div>
      </div>
      <div class="footer-bottom"><span>© 2026 Starpil Caribbean. All rights reserved.</span><div><span>Trinidad &amp; Tobago</span><span>USD professional pricing</span></div></div>
    </footer>
  </template>

  <template id="starpil_product_card" name="Starpil Product Card">
    <article class="product-card">
      <div class="product-image">
        <span t-if="product.starpil_website_badge" class="product-badge" t-out="product.starpil_website_badge"/>
        <a class="product-image-link" t-att-href="'/starpil/product/%s' % slug(product)" t-att-aria-label="'View %s' % product.name"><img t-att-src="'/web/image/product.template/%s/image_1024' % product.id" t-att-alt="product.name" loading="lazy"/></a>
        <a class="product-quick" t-att-href="'/starpil/product/%s' % slug(product)" t-out="'View &amp; purchase' if approved else 'View product'"/>
      </div>
      <div class="product-meta" t-out="product.public_categ_ids[:1].name or 'Professional Waxing'"/>
      <h3><a t-att-href="'/starpil/product/%s' % slug(product)" t-out="product.name"/></h3>
      <t t-if="approved">
        <div class="approved-card-price">
          <strong><span t-out="product._starpil_website_price(request.env.user.partner_id, pricelist=pricelist)" t-options='{"widget":"monetary","display_currency":pricelist.currency_id}'/></strong>
          <span t-out="'In stock' if product.qty_available &gt; 0 else 'Check availability'"/>
        </div>
        <small class="starpil-card-points">Earn approximately <b t-out="product._starpil_estimated_points(request.env.user.partner_id, 1.0, pricelist=pricelist)"/> points</small>
      </t>
      <a t-else="" class="locked-price" t-att-href="'/web/login?redirect=/starpil/product/%s' % slug(product)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="1"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        Sign in to see price
      </a>
    </article>
  </template>

  <template id="starpil_homepage" name="Starpil Caribbean Homepage">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/>
      <t t-call="starpil_website.starpil_header"/>
      <main class="starpil-odoo-storefront">
        <section class="hero">
          <div class="hero-copy"><div class="eyebrow"><span/> The professional waxing standard</div><h1>Better wax.<br/><em>Better business.</em></h1><p class="hero-lead">Professional waxes, equipment and treatment essentials trusted by estheticians—and supplied locally for the Caribbean.</p><div class="hero-actions"><a class="button button-dark" href="/starpil/shop">Shop professional products</a><a class="text-link" href="/pro-account">Apply for Pro Access <span aria-hidden="true">↗</span></a></div><div class="hero-proof"><div><strong>30+</strong><span>Years of expertise</span></div><div><strong>65+</strong><span>Countries worldwide</span></div><div><strong>Pro-only</strong><span>Approved pricing</span></div></div></div>
          <div class="hero-visual" data-starpil-hero="" aria-label="Featured Starpil product photography"><div class="hero-visual-slides"><img class="hero-visual-slide hero-photo-slide is-active" data-starpil-hero-slide="" src="/starpil_website/static/src/img/hero-official-blue-wax.png" alt="Professional blue wax application by Starpil"/><img class="hero-visual-slide hero-product-slide hero-coral-slide" data-starpil-hero-slide="" src="/starpil_website/static/src/img/hero-official-coral.png" alt="Starpil Coral professional hard wax" loading="lazy"/><img class="hero-visual-slide hero-product-slide hero-warmer-slide" data-starpil-hero-slide="" src="/starpil_website/static/src/img/hero-official-warmer.png" alt="Starpil professional wax warmer" loading="lazy"/></div><div class="hero-stamp"><span>STARPIL</span><strong>CARIBBEAN</strong><small>PROFESSIONAL SUPPLY</small></div><div class="hero-caption"><p>High-performance formulas.<br/>Made for working estheticians.</p></div><div class="hero-image-controls"><button class="hero-image-arrow" type="button" data-starpil-hero-prev="" aria-label="Previous banner image">←</button><div class="hero-image-dots"><button class="hero-image-dot is-active" type="button" data-starpil-hero-dot="0" aria-label="Show image 1"/><button class="hero-image-dot" type="button" data-starpil-hero-dot="1" aria-label="Show image 2"/><button class="hero-image-dot" type="button" data-starpil-hero-dot="2" aria-label="Show image 3"/></div><button class="hero-image-arrow" type="button" data-starpil-hero-next="" aria-label="Next banner image">→</button></div></div>
        </section>

        <section class="trust-strip" aria-label="Starpil benefits"><div><span class="trust-icon">✓</span><p><strong>Authentic Starpil</strong><small>Official local product supply</small></p></div><div><span class="trust-icon">✦</span><p><strong>Certified pros only</strong><small>Exclusive approved pricing</small></p></div><div><span class="trust-icon">→</span><p><strong>Caribbean delivery</strong><small>Custom Odoo delivery options</small></p></div><div><span class="trust-icon">◎</span><p><strong>Real-time account</strong><small>Stock, orders and rewards</small></p></div></section>

        <section class="section category-section" id="collections">
          <div class="section-heading"><div><span class="kicker">The complete professional system</span><h2>Shop by collection</h2></div><p>Collections and their header tabs are controlled directly in Odoo. Product assignment, publication and inventory stay in one live catalogue.</p></div>
          <div t-if="home_categories" class="category-grid"><a t-foreach="home_categories" t-as="category" t-att-class="'category-card %s' % category._starpil_card_class()" t-att-href="'/starpil/shop?category=%s' % category.id"><img t-if="category.image_1920" t-att-src="'/web/image/product.public.category/%s/image_1920' % category.id" t-att-alt="category.name"/><div t-if="category.starpil_card_style == 'dark' and not category.image_1920" class="wax-orb wax-orb-white"/><div><small t-out="category.starpil_card_kicker or 'Professional collection'"/><h3 t-out="category.name"/><span>Explore collection →</span></div></a></div>
          <div t-else="" class="category-grid"><a class="category-card category-card-large" href="/starpil/shop"><img src="/starpil_website/static/src/img/coral-collection.webp" alt="Premium film wax collection"/><div><small>Signature formulas</small><h3>Stripless Film Wax</h3><span>Explore collection →</span></div></a><a class="category-card category-card-dark" href="/starpil/shop"><div class="wax-orb wax-orb-white"/><div><small>For sensitive skin</small><h3>Starsoft Luxury</h3><span>Explore collection →</span></div></a><a class="category-card category-card-blue" href="/starpil/shop"><img src="/starpil_website/static/src/img/soft-wax-collection.webp" alt="Starpil professional soft wax cans"/><div><small>Efficient full-body services</small><h3>Soft Strip Wax</h3><span>Explore collection →</span></div></a><a class="category-card category-card-gold" href="/starpil/shop"><img src="/starpil_website/static/src/img/gold-soft-wax.webp" alt="Starpil gold wax products"/><div><small>Fast, clean application</small><h3>Roll-On Systems</h3><span>Explore collection →</span></div></a><a class="category-card category-card-plain" href="/starpil/shop"><img class="contained" src="/starpil_website/static/src/img/esthie-warmer.png" alt="Starpil professional wax warmer"/><div><small>Built for daily service</small><h3>Professional Warmers</h3><span>Explore collection →</span></div></a><a class="category-card category-card-pink" href="/starpil/shop"><img class="contained" src="/starpil_website/static/src/img/post-epil-oil.png" alt="Starpil post epil treatment oil"/><div><small>Prep, calm and restore</small><h3>Treatment Products</h3><span>Explore collection →</span></div></a></div>
        </section>

        <section class="section products-section"><div class="section-heading section-heading-row"><div><span class="kicker">Professional favourites</span><h2>Best sellers</h2></div><div class="product-tabs"><a class="is-active" href="/starpil/shop">All</a><a t-foreach="header_categories[:4]" t-as="category" t-att-href="'/starpil/shop?category=%s' % category.id" t-out="category.name"/></div></div><div class="product-grid"><t t-foreach="products" t-as="product"><t t-call="starpil_website.starpil_product_card"/></t><div t-if="not products" class="starpil-empty-catalogue"><h3>Your live catalogue is ready.</h3><p>Publish products from the Starpil Website tab in Odoo and they will appear here immediately.</p></div></div><div class="centered-action"><a class="button button-outline" href="/starpil/shop">View all professional products</a></div></section>

        <section class="pro-banner"><div class="pro-copy"><span class="kicker kicker-light">The Starpil Pro Portal</span><h2>Your professional account<br/><em>works as hard as you do.</em></h2><p>Create your account once, verify your email and upload your professional credential. After admin approval, your USD pricelist, stock, cart, checkout, orders and rewards unlock automatically.</p><ul class="pro-benefits"><li>Exclusive professional pricing</li><li>Faster repeat ordering</li><li>Order history and loyalty access</li></ul><div class="hero-actions"><a class="button button-light" href="/pro-account">Create a Pro Account</a><a class="text-link text-link-light" href="/web/login?redirect=/my/starpil">Already approved? Sign in ↗</a></div></div><div class="pro-visual"><div class="pro-ring pro-ring-one"/><div class="pro-ring pro-ring-two"/><img src="/starpil_website/static/src/img/esthie-pro.webp" alt="Starpil professional esthetician"/><div class="pro-badge"><strong>PRO</strong><span>Pricing unlocked<br/>after approval</span></div></div></section>

        <section class="editorial-grid"><article class="editorial-image"><img src="/starpil_website/static/src/img/gold-soft-wax.webp" alt="Professional Starpil waxing setup"/><div><span>PROFESSIONAL SUPPORT</span><h2>More than products.<br/>A partner in your treatment room.</h2></div></article><article class="editorial-copy"><span class="kicker">The Starpil difference</span><h2>Made for the people behind every smooth result.</h2><p>From choosing the right wax to keeping your treatment room stocked, Starpil Caribbean supports certified beauty professionals with authentic products, local access and responsive guidance.</p><div class="editorial-points"><div><span>Professional-grade performance</span></div><div><span>Esthetician-approved systems</span></div><div><span>Caribbean-focused service</span></div><div><span>Real-time Odoo ordering</span></div></div><a class="button button-dark" href="/contactus">Talk to our team</a></article></section>

        <section class="community-section"><div class="community-copy"><span class="kicker">For the EsthiePRO community</span><h2>Learn it. Melt it.<br/><em>Make it your signature.</em></h2><p>Follow product demonstrations, professional tips, treatment inspiration and stories from the Caribbean esthetics community.</p><a class="button button-outline" href="https://www.instagram.com/starpilwaxtt/" target="_blank" rel="noopener">Follow @starpilwaxtt</a></div><div class="community-cards"><article class="community-card community-card-one"><span>FORMULA FOCUS</span><strong>Choosing wax for short, coarse hair</strong></article><article class="community-card community-card-two"><span>PRO TECHNIQUE</span><strong>Get more from your roll-on system</strong></article><article class="community-card community-card-three"><span>AFTERCARE</span><strong>Calm and restore freshly waxed skin</strong></article></div></section>
      </main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

  <template id="starpil_shop" name="Starpil Pro Shop">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="starpil-odoo-storefront"><section class="page-hero page-hero-image"><img src="/starpil_website/static/src/img/soft-wax-collection.webp" alt="Starpil professional wax collection"/><div><div class="breadcrumbs"><a href="/">Home</a> / Shop</div><span class="kicker kicker-light">Professional catalogue</span><h1>Tools for better<br/>treatment rooms.</h1><p t-if="approved">Your approved USD professional pricelist, live stock and points estimates are active.</p><p t-else="">Browse the full product structure. Prices and purchasing remain locked until your certification is reviewed and your account is approved.</p></div></section><section class="shop-shell"><div class="shop-toolbar"><form class="shop-search" action="/starpil/shop" method="get"><label class="sr-only" for="starpil-shop-search">Search products</label><input id="starpil-shop-search" type="search" name="search" t-att-value="search" placeholder="Search professional products"/><button type="submit" aria-label="Search">⌕</button></form><div class="shop-filter" aria-label="Filter products"><a t-att-class="'is-active' if not selected_category else ''" href="/starpil/shop">All products</a><a t-foreach="categories" t-as="category" t-att-class="'is-active' if selected_category and selected_category.id == category.id else ''" t-att-href="'/starpil/shop?category=%s' % category.id" t-out="category.name"/></div></div><p class="shop-count"><t t-out="len(products)"/> professional product<t t-if="len(products) != 1">s</t><t t-if="approved"> · Approved account pricing</t></p><div class="product-grid"><t t-foreach="products" t-as="product"><t t-call="starpil_website.starpil_product_card"/></t><div t-if="not products" class="starpil-empty-catalogue"><h3>No products found.</h3><p>Try another collection or search term.</p></div></div></section><section t-if="not approved" class="newsletter"><div><span class="kicker kicker-light">Certified professional?</span><h2>Unlock your professional catalogue.</h2></div><div class="hero-actions"><a class="button button-light" href="/pro-account">Apply for Pro Access</a><a class="text-link text-link-light" href="/web/login?redirect=/starpil/shop">Already approved? Sign in ↗</a></div></section></main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

  <template id="starpil_product" name="Starpil Product">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="starpil-odoo-storefront"><section class="product-detail"><div class="product-layout"><div class="product-gallery"><div class="product-main-image"><img t-att-src="'/web/image/product.template/%s/image_1920' % product.id" t-att-alt="product.name"/></div></div><div class="product-info"><div class="breadcrumbs"><a href="/">Home</a> / <a href="/starpil/shop">Shop</a> / <t t-out="product.public_categ_ids[:1].name or 'Professional'"/></div><div class="product-meta" t-out="product.starpil_website_badge or product.public_categ_ids[:1].name or 'Professional collection'"/><h1 t-out="product.name"/><t t-if="approved"><div class="product-status product-status-unlocked"><div class="visible-price"><small>Professional price · <t t-out="price_currency.name"/></small><strong><span t-out="price" t-options='{"widget":"monetary","display_currency":price_currency}'/></strong></div><span t-if="product.starpil_show_stock" class="stock-status" t-out="'In stock' if product.qty_available &gt; 0 else 'Contact us for availability'"/></div><div class="product-points-preview" data-starpil-points-calculator="" t-att-data-unit-points="estimated_points"><span>★</span><p><strong>Earn approximately <b data-points-output="" t-out="estimated_points"/> points</strong><small>Your current tier and quantity · Posted after successful payment</small></p></div></t><div t-else="" class="product-status"><a class="locked-price" t-att-href="'/web/login?redirect=/starpil/product/%s' % slug(product)">🔒 Sign in to see price</a><span>Professional account required</span></div><div t-if="product.starpil_website_description" t-field="product.starpil_website_description"/><p t-else="" t-out="product.description_sale"/><form t-if="approved" action="/starpil/cart/add" method="post" class="product-purchase product-purchase-unlocked"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="product_tmpl_id" t-att-value="product.id"/><div class="purchase-summary"><strong>Ready for your treatment room.</strong><p>Live Odoo price, stock and points are active for this approved account.</p></div><div class="purchase-controls"><input class="starpil-quantity-input" type="number" name="quantity" min="1" max="99" value="1" aria-label="Quantity"/><button class="button button-dark" type="submit">Add to cart</button></div></form><div t-else="" class="product-purchase"><strong>Professional pricing is protected.</strong><p>Sign in with an approved account to view your USD price, stock availability, points and ordering options.</p><a class="button button-dark" t-att-href="'/web/login?redirect=/starpil/product/%s' % slug(product)">Sign in to purchase</a></div><div class="product-spec"><div><span>SKU</span><strong t-out="product.default_code or 'Starpil Professional'"/></div><div><span>Stock</span><strong t-out="'Live in Odoo' if approved else 'Unlock after approval'"/></div><div><span>Access</span><strong>Approved professionals</strong></div><div><span>Collection</span><strong t-out="product.public_categ_ids[:1].name or 'Professional'"/></div></div></div></div></section></main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

  <template id="starpil_cart" name="Starpil Pro Cart">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="starpil-live-site starpil-live-section"><div class="starpil-shop-title"><span class="kicker">Approved account</span><h1>Your Pro cart.</h1><p>Prices and totals use the live Odoo order in USD.</p></div><div t-if="not order or not order.order_line" class="starpil-live-empty"><h2>Your cart is empty.</h2><a class="button button-dark" href="/starpil/shop">Shop professional products</a></div><div t-else="" class="starpil-live-cart-layout"><section class="starpil-live-cart-lines"><article t-foreach="order.order_line.filtered(lambda l: not l.display_type and not l.is_delivery)" t-as="line" class="starpil-live-cart-line"><img t-att-src="'/web/image/product.product/%s/image_256' % line.product_id.id" t-att-alt="line.product_id.name"/><div><small t-out="line.product_id.default_code or 'Starpil Professional'"/><h2 t-out="line.product_id.name"/><strong><span t-field="line.price_unit" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><form action="/starpil/cart/update" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="line_id" t-att-value="line.id"/><input type="number" name="quantity" min="0" max="99" t-att-value="int(line.product_uom_qty)"/><button type="submit">Update</button></form><strong><span t-field="line.price_subtotal" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></article></section><aside class="starpil-live-summary"><span class="kicker">Order summary</span><h2>Pro Cart</h2><div><span>Subtotal</span><strong><span t-field="order.amount_untaxed" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><div><span>Taxes</span><strong><span t-field="order.amount_tax" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><div class="starpil-live-total"><span>Total</span><strong><span t-field="order.amount_total" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><div class="starpil-points-box"><span>★</span><p><strong>Earn approximately <b t-out="order.starpil_points_estimate"/> points</strong><small>Posted after successful payment</small></p></div><a class="button button-dark" href="/starpil/checkout">Proceed to secure checkout</a></aside></div></main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

  <template id="starpil_checkout" name="Starpil Checkout Review">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="starpil-live-site starpil-live-section"><div class="starpil-live-checkout"><section><span class="kicker">Secure checkout</span><h1>Complete your order.</h1><p>Odoo confirms your address, custom delivery fee, taxes and enabled payment provider on the secure checkout screens.</p><div class="starpil-checkout-confidence"><span>✓ Approved USD professional pricing</span><span>✓ Live Odoo stock and order data</span><span>✓ Points post only after successful payment</span></div></section><aside class="starpil-live-summary"><span class="kicker">Your order</span><h2>Checkout summary</h2><div><span>Subtotal</span><strong><span t-field="order.amount_untaxed" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><div><span>Taxes</span><strong><span t-field="order.amount_tax" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><div class="starpil-live-total"><span>Current total</span><strong><span t-field="order.amount_total" t-options='{"widget":"monetary","display_currency":order.currency_id}'/></strong></div><div class="starpil-points-box"><span>★</span><p><strong>This order will earn approximately <b t-out="order.starpil_points_estimate"/> points</strong><small>Final eligible value recalculates before payment · Points post after payment</small></p></div><form action="/starpil/loyalty/coupon/apply" method="post" class="starpil-coupon-form"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><label for="starpil-coupon">Reward or promotion code</label><div><input id="starpil-coupon" name="code" placeholder="SP-XXXXXXXX"/><button type="submit">Apply</button></div><small t-if="coupon_applied" class="text-success">Reward coupon applied.</small><small t-if="coupon_error" class="text-danger">This coupon is invalid, expired or does not meet its minimum order.</small></form><a class="button button-dark" href="/shop/checkout">Continue in secure Odoo checkout</a><a class="starpil-return-link" href="/starpil/cart">← Return to cart</a></aside></div></main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>

  <template id="pro_account_page_starpil_chrome" inherit_id="starpil_pro_core.pro_account_page" name="Starpil Pro Account Chrome">
    <xpath expr="//main" position="before"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/></xpath>
    <xpath expr="//main" position="after"><t t-call="starpil_website.starpil_footer"/></xpath>
  </template>
  <template id="pro_account_check_email_starpil_chrome" inherit_id="starpil_pro_core.pro_account_check_email" name="Starpil Pro Check Email Chrome">
    <xpath expr="//main" position="before"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/></xpath>
    <xpath expr="//main" position="after"><t t-call="starpil_website.starpil_footer"/></xpath>
  </template>
  <template id="pro_account_verification_result_starpil_chrome" inherit_id="starpil_pro_core.pro_account_verification_result" name="Starpil Pro Verification Chrome">
    <xpath expr="//main" position="before"><t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/></xpath>
    <xpath expr="//main" position="after"><t t-call="starpil_website.starpil_footer"/></xpath>
  </template>
</odoo>
