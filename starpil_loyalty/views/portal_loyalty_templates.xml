<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="portal_loyalty_wallet" name="Starpil Loyalty Wallet">
    <t t-call="website.layout">
      <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-call="starpil_website.starpil_header"/>
      <main class="portal-main starpil-portal-live">
        <section class="portal-heading"><div><span class="kicker">Professional loyalty</span><h1>Rewards that grow<br/>with your business.</h1><p>Earn points on eligible purchases, progress through membership tiers and redeem rewards online or with your scannable digital card.</p></div></section>
        <div class="portal-layout">
          <t t-set="active" t-value="'loyalty'"/><t t-call="starpil_website.starpil_customer_nav"/>
          <div class="portal-content loyalty-content">
            <div t-if="not account" class="portal-panel portal-empty">No active Starpil loyalty program is configured. Ask an administrator to activate a program in Odoo.</div>
            <t t-else="">
              <section class="loyalty-hero-panel">
                <div class="loyalty-balance"><span>Available reward points</span><strong t-out="account.points_balance"/><p t-if="expiring"><t t-out="expiring.remaining_points"/> points expire on <span t-field="expiring.expiry_date"/></p><p t-else="">No points are currently approaching expiry.</p><div t-if="latest_earn"><b>+<t t-out="latest_earn.points"/></b><span>earned on your latest qualifying activity</span></div></div>
                <div class="digital-member-card"><div class="member-card-top"><img src="/starpil_website/static/src/img/starpil-wordmark.png" alt="Starpil"/><span>PRO REWARDS</span></div><div class="member-card-tier"><span>Current tier</span><strong t-out="account.tier_id.name or 'Member'"/></div><div class="member-card-person"><strong t-out="partner.name"/><span t-out="partner.starpil_business_name or 'Approved Starpil Professional'"/></div><img class="member-barcode member-barcode-image" t-att-src="'/report/barcode/?barcode_type=Code128&amp;value=%s&amp;width=700&amp;height=140&amp;humanreadable=1' % account.member_code" alt="Scannable Starpil member barcode"/><small><t t-out="account.member_code"/> · Scan in Odoo</small></div>
              </section>

              <section class="portal-panel loyalty-tier-progress"><div class="portal-section-heading"><div><span>Your membership tier</span><p>Tier progress is based on qualifying USD spend and does not decrease when points are redeemed.</p></div><span class="loyalty-tier-badge"><t t-out="account.tier_id.name or 'Member'"/> · <t t-out="account.tier_id.multiplier or 1"/>× POINTS</span></div><div class="loyalty-progress-copy"><strong><span t-field="account.qualifying_spend" t-options='{"widget":"monetary","display_currency":account.currency_id}'/> qualifying spend</strong><span t-if="next_tier"><span t-field="spend_to_next" t-options='{"widget":"monetary","display_currency":account.currency_id}'/> to <t t-out="next_tier.name"/></span><span t-else="">Highest tier reached</span></div><div class="loyalty-tier-line"><span t-att-style="'width: %.2f%%' % progress_percent"/><i t-foreach="tiers" t-as="tier" t-att-class="'tier-marker tier-marker-%s' % tier_index" t-att-style="'left: %.2f%%' % ((tier_index * 100.0 / max(len(tiers) - 1, 1)))" t-out="tier.name"/></div><div class="loyalty-benefits"><div><span>✓</span><p><strong><t t-out="account.tier_id.multiplier or 1"/>× points rate</strong><small>Applied automatically to eligible paid orders</small></p></div><div><span>✓</span><p><strong>Online rewards</strong><small>Redeem points for a checkout coupon</small></p></div><div><span>✓</span><p><strong>Digital member card</strong><small>Scan the same account in Odoo</small></p></div></div></section>

              <section class="portal-panel loyalty-rewards-panel"><div class="portal-section-heading"><div><span>Redeem your points</span><p>Redeeming creates a live coupon that can be applied in the Starpil checkout.</p></div><span><t t-out="account.points_balance"/> points available</span></div><div class="loyalty-reward-grid"><article t-foreach="rewards" t-as="reward" t-att-class="'is-locked' if account.points_balance &lt; reward.points_cost else ''"><span t-out="'PERCENTAGE DISCOUNT' if reward.reward_type == 'percent' else 'ORDER DISCOUNT'"/><h3><t t-if="reward.reward_type == 'percent'"><t t-out="reward.discount_value"/>% off</t><t t-else=""><span t-field="reward.discount_value" t-options='{"widget":"monetary","display_currency":reward.currency_id}'/> off</t></h3><p>Valid for <t t-out="reward.coupon_valid_days"/> days on eligible orders<t t-if="reward.minimum_order"> from <span t-field="reward.minimum_order" t-options='{"widget":"monetary","display_currency":reward.currency_id}'/></t>.</p><div><strong><t t-out="reward.points_cost"/> points</strong><form t-if="account.points_balance &gt;= reward.points_cost" t-att-action="'/my/starpil/loyalty/redeem/%s' % reward.id" method="post"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><button type="submit">Redeem</button></form><button t-else="" type="button" disabled="disabled">Keep earning</button></div></article></div></section>

              <section t-if="coupons" class="portal-panel loyalty-rewards-panel"><div class="portal-section-heading"><div><span>Your reward coupons</span><p>Use an active code in the custom Starpil checkout.</p></div></div><div class="loyalty-coupon-grid"><article t-foreach="coupons[:6]" t-as="coupon"><span t-att-class="'portal-status %s' % ('status-complete' if coupon.state == 'active' else 'status-shipped')" t-out="coupon.state.title()"/><strong t-out="coupon.code"/><small>Expires <span t-field="coupon.expiry_date"/></small></article></div></section>

              <div class="loyalty-lower-grid">
                <section class="portal-panel loyalty-history"><div class="portal-section-heading"><div><span>Points activity</span><p>Your latest earnings, redemptions and expiry entries.</p></div></div><div><article t-foreach="account.transaction_ids[:20]" t-as="transaction"><span t-att-class="'points-plus' if transaction.points &gt;= 0 else 'points-minus'"><t t-out="'+' if transaction.points &gt;= 0 else ''"/><t t-out="transaction.points"/></span><p><strong t-out="transaction.description"/><small><span t-field="transaction.date" t-options='{"widget":"date"}'/><t t-if="transaction.expiry_date"> · Expires <span t-field="transaction.expiry_date"/></t></small></p><em t-out="transaction.transaction_type.title()"/></article><div t-if="not account.transaction_ids" class="portal-empty">Your points history will appear after your first eligible paid order.</div></div></section>
                <section class="portal-panel loyalty-how"><div class="portal-section-heading"><div><span>How points work</span><p>Your current live program rules.</p></div></div><ul><li><strong>Earn</strong><span>1 base point per <span t-field="account.program_id.spend_per_point" t-options='{"widget":"monetary","display_currency":account.currency_id}'/> of eligible untaxed spend</span></li><li><strong>Tier bonus</strong><span>Earn at <t t-out="account.tier_id.multiplier or 1"/>× while in your current tier</span></li><li><strong>Redeem</strong><span>Choose any reward you can afford and receive a checkout coupon</span></li><li><strong>Expiry</strong><span t-out="'Points expire %s months after earning' % account.program_id.expiry_months if account.program_id.expiry_months else 'Points do not expire'"/></li></ul></section>
              </div>
            </t>
          </div>
        </div>
      </main>
      <t t-call="starpil_website.starpil_footer"/>
    </t>
  </template>
</odoo>
