<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="product_template_form_starpil_loyalty" model="ir.ui.view">
    <field name="name">product.template.form.starpil.loyalty</field><field name="model">product.template</field><field name="inherit_id" ref="starpil_website.product_template_form_starpil_website"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='starpil_website']/group[1]/group[2]" position="inside">
        <separator string="Loyalty"/><field name="starpil_loyalty_eligible"/><field name="starpil_loyalty_multiplier" invisible="not starpil_loyalty_eligible"/>
      </xpath>
    </field>
  </record>
</odoo>
